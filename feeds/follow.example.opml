        title="东方财富·宏观"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/eastmoney/topic/宏观"
        htmlUrl="https://www.eastmoney.com/"
      />
      <outline
        text="东方财富·产业"
        title="东方财富·产业"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/eastmoney/topic/产业"
        htmlUrl="https://www.eastmoney.com/"
      />
      <outline
        text="东方财富·研报"
        title="东方财富·研报"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/eastmoney/topic/研报"
        htmlUrl="https://www.eastmoney.com/"
      />
      <outline
        text="东方财富·政策"
        title="东方财富·政策"
        type="rss"
