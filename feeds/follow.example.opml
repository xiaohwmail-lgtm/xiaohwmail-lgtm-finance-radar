    <outline text="国际财经">
      <outline
        text="Bloomberg Markets"
        title="Bloomberg Markets"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/bloomberg/markets"
        htmlUrl="https://www.bloomberg.com/markets"
      />
      <outline
        text="Bloomberg Technology"
        title="Bloomberg Technology"
        type="rss"
