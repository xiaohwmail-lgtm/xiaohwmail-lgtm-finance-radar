        type="rss"
        xmlUrl="https://rsshub.rssforever.com/caixin/latest"
        htmlUrl="https://www.caixin.com/"
      />
      <outline
        text="FT中文网"
        title="FT中文网"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/ft/chinese"
        htmlUrl="https://www.ftchinese.com/"
      />
      <outline
        text="华尔街见闻·全球"
