<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>财经雷达 RSS 订阅示例</title>
  </head>
  <body>
    <outline text="财经快讯与综合">
      <outline
        text="财联社电报"
        title="财联社电报"
        type="rss"
        xmlUrl="https://rsshub.rssforever.com/cls/telegraph"
        htmlUrl="https://www.cls.cn/telegraph"
      />
